# =============================================================================
# Fund-My-Cause — Root Environment Template
# =============================================================================
# Copy this file to .env and fill in values appropriate for your environment.
# Never commit a .env file containing real secrets.
# See apps/interface/.env.example for Next.js-specific variables.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://fundmycause:fundmycause123@postgres:5432/fundmycause

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── API service ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
JWT_SECRET=dev-secret-key-change-in-production
CORS_ORIGIN=http://localhost:3002
LOG_LEVEL=info

# ── Indexer service ───────────────────────────────────────────────────────────
INDEXER_PORT=3001
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org
NETWORK=testnet
CONTRACT_NETWORK=testnet

# RPC tuning (optional — defaults apply when unset)
RPC_REQUEST_TIMEOUT_MS=30000
RPC_MAX_CONCURRENT_REQUESTS=10
RPC_RETRY_ATTEMPTS=3

# In-memory event store tuning (optional)
STORE_EVENT_BATCH_SIZE=100
STORE_MAX_EVENT_CAPACITY=10000
STORE_STALE_LEDGER_THRESHOLD_MS=60000
SIMULATION_MODE=false

# ── Contract addresses ────────────────────────────────────────────────────────
CROWDFUND_CONTRACT_ID=
REGISTRY_CONTRACT_ID=
ACHIEVEMENTS_CONTRACT_ID=
QF_CONTRACT_ID=

# ── GraphQL service ───────────────────────────────────────────────────────────
GRAPHQL_PORT=4000

# ── Frontend (Docker Compose) ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_INDEXER_URL=http://localhost:3001

# ── Docker Compose ────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=fundmycause

# ── Optional: Alerting & monitoring ──────────────────────────────────────────
ALERT_WEBHOOK_URL=
ALERT_RULES_CONFIG=
SLACK_WEBHOOK_URL=
PROMETHEUS_URL=http://localhost:9090
DEPLOYMENT_API_URL=
FRAUD_DETECTION_URL=

# ── Optional: PagerDuty ───────────────────────────────────────────────────────
PAGERDUTY_API_KEY=
PAGERDUTY_INTEGRATION_KEY=
PAGERDUTY_SERVICE_ID=

# ── Optional: Email notifications ─────────────────────────────────────────────
EMAIL_FROM=
EMAIL_TO=
EMAIL_SMTP_ENDPOINT=

# ── Optional: Cursor / event streaming ───────────────────────────────────────
CURSOR_SECRET=
