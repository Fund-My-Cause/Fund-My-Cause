{
  "name": "fund-my-cause",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "sdks/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/interface",
    "build": "npm run build --workspace=packages/shared-utils && npm run build --workspace=apps/interface",
    "lint": "eslint apps/interface/src apps/components-lib/src packages/types/src",
    "lint:dead-code": "npx --yes ts-prune@0.10.3 -p apps/interface/tsconfig.json",
    "lint:imports": "node scripts/check-import-aliases.mjs",
    "lint:all": "npm run lint && npm run lint:imports && npm run lint:dead-code",
    "test:quality": "node --test eslint-rules/__tests__/*.test.mjs scripts/__tests__/*.test.mjs",
    "test:a11y": "playwright test --grep @a11y",
    "test:contrast": "npx --yes ts-node scripts/check-contrast.ts",
    "test:unit": "npm run test --workspace=packages/shared-utils && npm run test --workspace=apps/interface",
    "contracts:build": "cargo build --release --target wasm32-unknown-unknown --manifest-path contracts/crowdfund/Cargo.toml",
    "contracts:test": "cargo test --workspace",
    "test:e2e": "playwright test",
    "fixtures:generate": "npx ts-node scripts/generate-fixtures.ts",
    "seed:testnet": "bash scripts/seed-testnet.sh",
    "format": "cd apps/interface && npx prettier --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.0",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,css,scss,yml,yaml}": [
      "prettier --write"
    ],
    "apps/**/*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ],
    "*.rs": [
      "bash -c 'cargo fmt --all -- --check'"
    ],
    "*.{ts,tsx}": [
      "bash scripts/lint-staged-check.sh"
    ]
  }
}
