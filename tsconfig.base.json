{
  "compilerOptions": {
    "target": "ES2020",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@fund-my-cause/types": ["packages/types/src/index.ts"],
      "@fund-my-cause/types/*": ["packages/types/src/*"],
      "@fund-my-cause/shared-utils": ["packages/shared-utils/src/index.ts"],
      "@fund-my-cause/shared-utils/*": ["packages/shared-utils/src/*"],
      "@fund-my-cause/rpc-client": ["packages/rpc-client/src/index.ts"],
      "@fund-my-cause/components": ["apps/components-lib/src/index.ts"],
      "@fund-my-cause/components/*": ["apps/components-lib/src/*"],
      "@fixtures/*": ["fixtures/*"]
    }
  },
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
